            <regions xmi:id="_Lj7ZUM9mEfCvnJWWyZ0RsQ" name="Wall Tracking">
              <vertices xsi:type="sgraph:Entry" xmi:id="_0OJr-NNmEfCuhtUmM0c0NQ">
                <outgoingTransitions xmi:id="_Aw1JYNNnEfCuhtUmM0c0NQ" specification="" target="_9ODmMNNmEfCuhtUmM0c0NQ"/>
              </vertices>
              <vertices xsi:type="sgraph:State" xmi:id="_9OCYWtNmEfCuhtUmM0c0NQ" specification="entry/&#xD;&#xA;&#xD;&#xA;dx = (originY - odom.y);    // kolommen: col neemt toe als odom.y afneemt&#xD;&#xA;dy = (odom.x - originX);    // rijen:    row-offset neemt toe als odom.x toeneemt&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;bx = (dx >= 0.0) ? 0.18 : -0.18;&#xD;&#xA;by = (dy >= 0.0) ? 0.12 : -0.12;&#xD;&#xA;&#xD;&#xA;tmpCol = floor((dx + bx) / grid.gridSize);&#xD;&#xA;tmpRow = floor((dy + by) / grid.gridSize);&#xD;&#xA;&#xD;&#xA;newCol = (tmpCol &lt; 0) ? 0 : tmpCol;&#xD;&#xA;newRow = (tmpRow &lt; 0) ? 0 : tmpRow;&#xD;&#xA;&#xD;&#xA;newCol = (newCol >= grid.maxCol) ? grid.maxCol - 1 : newCol;&#xD;&#xA;newRow = (newRow >= grid.maxRow) ? grid.maxRow - 1 : newRow" name="CalculateLocation" incomingTransitions="_9OENudNmEfCuhtUmM0c0NQ _9OENwdNmEfCuhtUmM0c0NQ">
                <outgoingTransitions xmi:id="_9ODACtNmEfCuhtUmM0c0NQ" specification="after 1 ms  " target="_9ODmkNNmEfCuhtUmM0c0NQ"/>
              </vertices>
              <vertices xsi:type="sgraph:State" xmi:id="_9ODmMNNmEfCuhtUmM0c0NQ" specification="entry/&#xD;&#xA;&#xD;&#xA;grid.receive = false;&#xD;&#xA;grid.update  = false;&#xD;&#xA;&#xD;&#xA;grid.column = 0;                // NIET grid.maxCol&#xD;&#xA;grid.row    = grid.maxRow - 1;  // 3 bij een 4x4&#xD;&#xA;&#xD;&#xA;lastCol = -1;&#xD;&#xA;lastRow = -1;&#xD;&#xA;&#xD;&#xA;visitedMask = 0;                // heel belangrijk: alles onvisited&#xD;&#xA;grid.visited = false" name="Idle" incomingTransitions="_Aw1JYNNnEfCuhtUmM0c0NQ">
                <outgoingTransitions xmi:id="_9ODmj9NmEfCuhtUmM0c0NQ" specification="" target="_9OENltNmEfCuhtUmM0c0NQ"/>
              </vertices>
