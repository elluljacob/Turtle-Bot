              <vertices xsi:type="sgraph:State" xmi:id="_oXJSt9HCEfCI-ZcSXIEwyA" specification="// At this point we have gotten to our &#xA;// target location, then we make &#xA;// the robot do a bad dance" name="DONE!" incomingTransitions="_oXJSutHCEfCI-ZcSXIEwyA">
