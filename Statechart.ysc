              </vertices>
              <vertices xsi:type="sgraph:State" xmi:id="_9OE0fdNmEfCuhtUmM0c0NQ" specification="entry /&#xA;&#xA;grid.wallFront = (laserDistance.dFrontMean &lt; userVar.desiredDist + 0.1) ? 1 : 0;&#xA;grid.wallRight = (laserDistance.dRightMean &lt; userVar.desiredDist) ? 1 : 0;&#xA;grid.wallBack  = (laserDistance.dBackMean  &lt; userVar.desiredDist) ? 1 : 0;&#xA;grid.wallLeft  = (laserDistance.dLeftMean  &lt; userVar.desiredDist) ? 1 : 0;&#xA;&#xA;grid.update = true" name="WriteCellOnce" incomingTransitions="_9OE0cdNmEfCuhtUmM0c0NQ">
                <outgoingTransitions xmi:id="_9OE1CNNmEfCuhtUmM0c0NQ" specification="after 100 ms" target="_9OE0UNNmEfCuhtUmM0c0NQ"/>
