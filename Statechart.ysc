                <outgoingTransitions xmi:id="_9OFbY9NmEfCuhtUmM0c0NQ" specification="[isTurning]" target="_9OFbYNNmEfCuhtUmM0c0NQ"/>
                <outgoingTransitions xmi:id="_9OFbZ9NmEfCuhtUmM0c0NQ" specification="[!isTurning]" target="_9OFbbNNmEfCuhtUmM0c0NQ"/>
              </vertices>
              <vertices xsi:type="sgraph:State" xmi:id="_9OFbbNNmEfCuhtUmM0c0NQ" name="WaitStable" incomingTransitions="_9OFbZ9NmEfCuhtUmM0c0NQ">
                <outgoingTransitions xmi:id="_9OFbb9NmEfCuhtUmM0c0NQ" specification="after 1 s" target="_9OE0cNNmEfCuhtUmM0c0NQ"/>
