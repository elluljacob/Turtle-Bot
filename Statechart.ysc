              </vertices>
              <vertices xsi:type="sgraph:State" xmi:id="_oXJ5zdHCEfCI-ZcSXIEwyA" specification="entry/ output.speed = 0.0;&#xA;// Since we can't use lidar, we need to manually manipulate the speed as our &#xA;// forward checks the front wall distance so it never crashes head on &#xA;grid.row  = (grid.orientation == 0) ? (grid.row - 1)   : grid.row;&#xA;grid.row  = (grid.orientation == 2) ? (grid.row + 1)   : grid.row;&#xA;grid.column  = (grid.orientation == 1) ? (grid.column + 1)   : grid.column;&#xA;grid.column  = (grid.orientation == 3) ? (grid.column - 1)   : grid.column;&#xA;userVar.lastNoLidarMovementActionLeft = false&#xA;" name="Calculate Location" incomingTransitions="_oXLIHdHCEfCI-ZcSXIEwyA">
