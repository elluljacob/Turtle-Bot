                <outgoingTransitions xmi:id="_9ODmkdNmEfCuhtUmM0c0NQ" specification="[newCol != lastCol || newRow != lastRow]" target="_9OENQNNmEfCuhtUmM0c0NQ"/>
                <outgoingTransitions xmi:id="_9ODmm9NmEfCuhtUmM0c0NQ" specification="else" target="_9OENvtNmEfCuhtUmM0c0NQ"/>
              </vertices>
              <vertices xsi:type="sgraph:State" xmi:id="_9OENQNNmEfCuhtUmM0c0NQ" specification="entry /&#xA;&#xA;grid.column = newCol;&#xA;grid.row    = (grid.maxRow - 1) - newRow;&#xA;&#xA;lastCol         = newCol;&#xA;lastRow         = newRow;&#xA;&#xA;cellIdx = grid.row * grid.maxCol + grid.column;&#xA;cellBit = 1 &lt;&lt; cellIdx" name="EnterCellPos" incomingTransitions="_9ODmkdNmEfCuhtUmM0c0NQ">
                <outgoingTransitions xmi:id="_9OENldNmEfCuhtUmM0c0NQ" specification="" target="_9OFbYNNmEfCuhtUmM0c0NQ"/>
