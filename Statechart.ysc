                    <outgoingTransitions xmi:id="_TfkaMM9mEfCvnJWWyZ0RsQ" specification="[(userVar.rightPrev&#xA;&#x9;> laserDistance.dRightMean)&#xA;&#x9;&amp;&amp; &#xA;&#x9;laserDistance.dRightMean &lt; 0.25]" target="_Tffhxs9mEfCvnJWWyZ0RsQ"/>
