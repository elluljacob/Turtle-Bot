<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:notation="http://www.eclipse.org/gmf/runtime/1.0.2/notation" xmlns:sgraph="http://www.yakindu.org/sct/sgraph/2.0.0">
  <sgraph:Statechart xmi:id="_H3ZnkBtMEeuKLrIwlRh1BQ" specification="@EventDriven&#xA;@ChildFirstExecution&#xA;&#xA;internal:&#xA;&#x9;operation floor(val:real): integer&#xA;&#x9;&#xA;&#x9;event stop&#xA;&#x9;var isTurning : boolean = false // Prevents logging the cell while turning for accuracy &#xA;&#x9;var visitedMask : integer = 0&#xA;&#x9;var cellIdx : integer&#xA;&#x9;var cellBit : integer&#xA;&#x9;var originX:real = 0.0&#xA;&#x9;var originY:real = 0.0&#xA;&#x9;var originSet:boolean = false&#xA;&#x9;&#xA;&#x9;var dx:real = 0.0&#xA;&#x9;var dy:real = 0.0&#xA;&#x9;var bx:real = 0.0&#xA;&#x9;var by:real = 0.0&#xA;&#x9;&#xA;&#x9;var tmpCol:integer = 0&#xA;&#x9;var tmpRow:integer = 0&#xA;&#x9;&#xA;&#x9;var newCol:integer = 0&#xA;&#x9;var newRow:integer = 0&#xA;&#x9;&#xA;&#x9;var lastCol:real = 0&#xA;&#x9;var lastRow:real = 0&#xA;&#x9;&#xA;&#x9;var targetRow:integer = 2 // The target cell to go to in lidar-free movement&#xA;&#x9;var targetColumn:integer = 2&#xA;&#x9;&#xA;&#x9;event rotateRight // Initiate a rotation to the right&#xA;&#x9;event finishedRotRight // Signal that we stopped rotating right&#xA;&#x9;&#xA;&#x9;event rotateLeft // Initiate a rotation to the left&#xA;&#x9;event finishedRotLeft // Signal ..&#xA;&#x9;&#xA;&#x9;// Same as previous 2 for forward and reverse&#xA;&#x9;event forward &#xA;&#x9;event finishedForward&#xA;&#x9;&#xA;&#x9;event reverse&#xA;&#x9;event finishedReversing&#xA;&#xA;&#x9;event rotateRight90 // Initiate a rotation to the right by 90 degrees&#xA;&#x9;event rotateLeft90 // ... left ...&#xA;&#x9;&#xA;&#x9;event calculateDirection  // Calculate the yaw we need to go to&#xA;&#x9;event calculateDirectionFinished // Signal that we're done&#xA;&#x9;&#xA;interface userVar:&#xA;    // userVar: not part of the robot interface.&#xA;    // You can modify this as you wish. &#xA;&#x9;var baseSpeed:real =0.1 &#xA;&#x9;var baseRotation:real = 0.2&#xA;&#x9;var startprocedure:boolean = true&#xA;&#x9;&#xA;&#x9;// Movement Timing (ms)&#xA;&#x9;var accelerationDuration = 500&#xA;&#x9;var rotationDuration = 50&#xA;&#x9;var minDistance = 0.3 // Keep this amount of distance from front wall&#xA;&#x9;var multiplier:integer = 1 // 1 to rotate left, -1 to rotate right (for 90 degrees turns)&#xA;   &#x9;var lastActionTurnLeft:boolean = false&#xA;    &#xA;    var distanceLarge :real = 0.5 // If the means are lower than this, there definately is no&#xA;    // wall in that direction (example if front mean is greater than this there is another cell&#xA;    // in front&#xA;    &#xA;    var initialYaw:real = 0.0 // The start yaw, North yaw is this yaw&#xA;&#x9;var targetYaw:real = 0.0 // The yaw to stop at when rotating to&#xA;&#x9;&#xA;&#x9;var directionFacing:integer  = 0 // 0 - North, 1 East, 2 South, 3 West&#xA;    var difference = 0.0 // Used to calculate the rotation speed amplification, &#xA;&#x9;// further away difference is larger so speed is larger. Vice versa up close&#xA;    &#xA;    var desiredDist :real =0.4 // Used similarly to distanceLarge, but at a different treshold &#xA;    // since this provides better accuracy in some cases&#xA;    &#xA;    var lastActionForward:boolean = false // Used to track to see if we should adjust ourselves&#xA;    // while moving forward&#xA;    &#xA;    var lastNoLidarMovementActionLeft:boolean = false&#xA;    // Used so we never end up turning left excessively. Ex: Robot approaches a &#xA;    // wall in front and no left and right wall, without this it would rotate left 3 times&#xA;    // and move to the right, instead of following left wall&#xA;&#xA;&#x9;var leftPrev:real = 0.0 // left mean distance logged in the previous move forward and adjust&#xA;    var rightPrev:real = 0.0 // same for right&#xA;    var scale:real = 0.0 // Rotation speed when turning 90 amplification&#xA;    &#xA;    var cellX: integer = 0&#xA;    var cellY: integer = 0&#xA;&#xA;&#xA;/////////////////////////////////////////////////////&#xA;// Robot Interface.&#xA;// Don't change anything below this line.&#xA;interface baseValues:&#xA;&#x9;var maxSpeed:real = 0.22&#xA;&#x9;var maxRotation:real = 2.84&#xA;&#x9;&#xA;&#x9;var degreesFront:integer = 10&#xA;&#x9;var degreesRight:integer = 10&#xA;&#x9;var degreesBack:integer = 10&#xA;&#x9;var degreesLeft:integer = 10&#xA;&#xA;&#xA;////////////////////////////////////////////////&#xA;// These values are output.&#xA;// The code sends these either &#xA;// to the TurtleBot3, or &#xA;// uses it within the code&#xA;interface output:&#xA;&#x9;var speed:real&#xA;&#x9;var rotation:real&#xA;&#x9;&#xA;&#x9;var obstacles:integer = 0&#xA;&#x9;var gems:integer = 0&#xA;&#x9;&#xA;&#x9;var finish:integer = 0&#xA;&#xA;////////////////////////////////////////////////&#xA;// Keeps track of variables &#xA;// in the grid&#xA;interface grid:&#xA;&#x9;var update:boolean = false&#xA;&#x9;var receive:boolean = false&#xA;&#x9;&#xA;&#x9;var column:integer = 0&#xA;&#x9;var row:integer = 0&#xA;&#x9;var orientation:integer&#xA;&#x9;&#xA;&#x9;var visited:boolean&#xA;&#x9;&#xA;&#x9;var wallFront:integer&#xA;&#x9;var wallRight:integer&#xA;&#x9;var wallBack:integer&#xA;&#x9;var wallLeft:integer&#xA;&#x9;&#xA;&#x9;var gridSize:real = 0.50&#xA;&#x9;var maxCol:integer = 4&#xA;&#x9;var maxRow:integer = 4&#xA;&#xA;////////////////////////////////////////////////&#xA;// Calibration variables&#xA;interface startPos:&#xA;&#x9;var setZero:boolean = false&#xA;&#x9;var zeroX:real&#xA;&#x9;var zeroY:real&#xA;&#x9;var zeroSouthDegree:real&#xA;&#x9;var laserDegOffset:integer&#xA;&#xA;&#xA;////////////////////////////////////////////////&#xA;// Keyboard input in the&#xA;// form of events&#xA;interface computer:&#xA;&#x9;in event m_press&#xA;&#x9;in event w_press&#xA;&#x9;in event a_press&#xA;&#x9;in event s_press&#xA;&#x9;in event d_press&#xA;&#x9;in event x_press&#xA;&#xA;////////////////////////////////////////////////&#xA;// The data from the IMU in&#xA;// Euler angles.&#xA;interface imu:&#xA;&#x9;var pitch:real&#xA;&#x9;var roll:real&#xA;&#x9;var yaw:real&#xA;&#xA;////////////////////////////////////////////////&#xA;// The data from the odometry in&#xA;// the x, y and z directions.&#xA;interface odom:&#xA;&#x9;var x:real&#xA;&#x9;var y:real&#xA;&#x9;var z:real&#xA;&#xA;////////////////////////////////////////////////&#xA;// Distance data from the &#xA;// LDS&#xA;interface laserDistance:&#xA;&#x9;var d0:real&#xA;&#x9;var d90:real&#xA;&#x9;var d180:real&#xA;&#x9;var dm90:real&#xA;&#x9;&#xA;&#x9;var dMin:real&#xA;&#x9;var minDeg:integer&#xA;&#x9;&#xA;&#x9;var dMax:real&#xA;&#x9;var maxDeg:integer&#xA;&#x9;&#xA;&#x9;var dMean:real&#xA;&#x9;&#xA;&#x9;var dFrontMin:real&#xA;&#x9;var minDegF:integer&#xA;&#x9;var dFrontMax:real&#xA;&#x9;var maxDegF:integer&#xA;&#x9;var dFrontMean:real&#xA;&#x9;&#xA;&#x9;var dRightMin:real&#xA;&#x9;var minDegR:integer&#xA;&#x9;var dRightMax:real&#xA;&#x9;var maxDegR:integer&#xA;&#x9;var dRightMean:real&#xA;&#x9;&#xA;&#x9;var dBackMin:real&#xA;&#x9;var minDegB:integer&#xA;&#x9;var dBackMax:real&#xA;&#x9;var maxDegB:integer&#xA;&#x9;var dBackMean:real&#xA;&#x9;&#xA;&#x9;var dLeftMin:real&#xA;&#x9;var minDegL:integer&#xA;&#x9;var dLeftMax:real&#xA;&#x9;var maxDegL:integer&#xA;&#x9;var dLeftMean:real&#xA;&#xA;////////////////////////////////////////////////&#xA;// Intensity data from the &#xA;// LDS&#xA;interface laserIntensity:&#xA;&#x9;var i0:real&#xA;&#x9;var i90:real&#xA;&#x9;var i180:real&#xA;&#x9;var im90:real&#xA;&#x9;&#xA;&#x9;var iFrontMin:real&#xA;&#x9;var iFrontMax:real&#xA;&#x9;var iFrontMean:real&#xA;&#x9;&#xA;&#x9;var iRightMin:real&#xA;&#x9;var iRightMax:real&#xA;&#x9;var iRightMean:real&#xA;&#x9;&#xA;&#x9;var iBackMin:real&#xA;&#x9;var iBackMax:real&#xA;&#x9;var iBackMean:real&#xA;&#x9;&#xA;&#x9;var iLeftMin:real&#xA;&#x9;var iLeftMax:real&#xA;&#x9;var iLeftMean:real" name="model">
