          <vertices xsi:type="sgraph:State" xmi:id="_Fb0UgMrlEfCVk6NeokQvrg" specification="entry / userVar.initialYaw = imu.yaw;&#xA;userVar.directionFacing = 0 &#xA;// Set the initial variables, we are facing North (0)&#xA;// and our north yaw is the current imu.yaw " name="Take Initial Yaw" incomingTransitions="_BbO-ALsNEfCM--j4weeHRA">
