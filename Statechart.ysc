                <outgoingTransitions xmi:id="_oXLH99HCEfCI-ZcSXIEwyA" specification="finishedRotRight" target="_oXLH-9HCEfCI-ZcSXIEwyA"/>
              </vertices>
              <vertices xsi:type="sgraph:State" xmi:id="_oXLH-9HCEfCI-ZcSXIEwyA" specification="entry / raise rotateRight90   " name="DoItAgain" incomingTransitions="_oXLH99HCEfCI-ZcSXIEwyA">
