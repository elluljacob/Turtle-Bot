            <regions xmi:id="_oXIrg9HCEfCI-ZcSXIEwyA" name="r1">
              <vertices xsi:type="sgraph:State" xmi:id="_oXIrhNHCEfCI-ZcSXIEwyA" specification="entry /&#xA;originSet = true;&#xA;grid.orientation = 0;&#xA;userVar.directionFacing = 0;&#xA;grid.column = 0;&#xA;grid.row    = grid.maxRow - 1;&#xA;lastCol = -1;&#xA;lastRow = -1&#xA;// The logic here is entirely &#xA;// self contained except for rotate 90. &#xA;// On entry we set the start location, &#xA;// same as when we start the &#xA;//automatic movement" name="Entry" incomingTransitions="_oXJSo9HCEfCI-ZcSXIEwyA">
